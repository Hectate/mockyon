{
    "dependencies": {
        "@fastify/formbody": "^9.0.0",
        "@fastify/static": "^10.1.3",
        "@fastify/type-provider-typebox": "^6.1.0",
        "@fastify/websocket": "^11.3.0",
        "fastify": "^5.12.3",
        "tachyon-protocol": "^1.24.0",
        "typebox": "^1.3.28"
    },
    "name": "mockyon",
    "version": "0.0.1",
    "description": "Mock Tachyon Server for limited utility",
    "type": "module",
    "main": "build/server/index.js",
    "scripts": {
        "build:client": "vite build --config src/client/vite.config.ts",
        "build:server": "tsc -p src/server/tsconfig.json",
        "build": "npm run build:client && npm run build:server",
        "prestart": "npm run build",
        "start": "node build/server/index.js",
        "serve": "node build/server/index.js",
        "typecheck": "tsc -p src/server/tsconfig.json --noEmit && vue-tsc -p src/client/tsconfig.json --noEmit",
        "lint": "eslint --cache",
        "format": "prettier --experimental-cli --write .",
        "format:check": "prettier --experimental-cli --check .",
        "checks": "concurrently \"npm run typecheck\" \"npm run lint\" \"npm run format:check\"",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "Nathaniel Mitchell",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@types/node": "^26.5.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    }
}
